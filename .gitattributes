# Normalise les fins de ligne : LF dans le dépôt et dans le dossier de travail.
* text=auto eol=lf

# Scripts Windows : doivent rester en CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires : jamais convertis.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.jar binary
*.apk binary
