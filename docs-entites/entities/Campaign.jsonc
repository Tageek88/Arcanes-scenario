{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom de la campagne"
    },
    "universe_type": {
      "type": "string",
      "enum": ["arcanes", "heroic_fantasy", "cosmic_horror", "gothic", "cyberpunk", "space_opera", "dark_fantasy", "custom"],
      "description": "Type d'univers de la campagne"
    },
    "system": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "preparation",
        "en_cours",
        "terminee"
      ],
      "default": "preparation"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
          "created_by_id": "{{user.id}}"
        },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
  }
}
      ]
    }
  }
}
