{
  "name": "Scene",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "act_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "gm_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "brouillon",
        "joue",
        "clef"
      ],
      "default": "brouillon"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "next_scene_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "npc_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "campaign_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}